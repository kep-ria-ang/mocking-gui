{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commitMessage": "chore(release): bump @kakaocloud/mocking-gui to ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true
  },
  "npm": {
    "publish": true,
    "publishArgs": ["--provenance", "--access", "public"]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": { "name": "conventionalcommits" },
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to `@kakaocloud/mocking-gui` are documented here. Generated from Conventional Commits by release-it.\n",
      "ignoreRecommendedBump": false
    }
  },
  "hooks": {
    "before:init": ["pnpm lint", "pnpm test", "pnpm build"]
  }
}
